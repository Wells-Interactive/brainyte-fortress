# ==========================================================================
# Brainyte Fortress
# Wells Interactive Services Ltd.
#
# Purpose: exclude build output, dependencies, secrets, local tooling and
# machine-specific files.
#
# This file MUST NOT exclude first-party source code, documentation,
# migrations, tests, contracts or configuration templates. Platform source and
# documentation are tracked.
# ==========================================================================


# --------------------------------------------------------------------------
# Secrets and credentials — never commit (INSTRUCTIONS §12)
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.asc
*.gpg
*.kdbx
id_rsa*
id_ed25519*
secrets.yml
secrets.yaml
secrets.json
!**/secrets/*.example
!**/secrets/*.template

# Secret material, while allowing infrastructure/secrets/ references to be tracked
infrastructure/secrets/*
!infrastructure/secrets/.gitkeep
!infrastructure/secrets/*.example
!infrastructure/secrets/*.template
!infrastructure/secrets/README.md


